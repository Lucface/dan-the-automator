# Content Collector Configuration
# Copy this to .env and fill in your values

# Server
PORT=3001
API_SECRET=your-secret-key-here

# AI Processing (required)
ANTHROPIC_API_KEY=sk-ant-...

# Database (required)
DATABASE_URL=postgresql://user:password@localhost:5432/content_collector

# Email Ingestion (optional)
# Enable email capture by forwarding/sending to this inbox
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=your-capture-email@gmail.com
EMAIL_IMAP_PASSWORD=app-specific-password
EMAIL_CHECK_INTERVAL=60

# Storage
STORAGE_PATH=./content

# Notifications (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Development
NODE_ENV=development
